# Copy to .env to override defaults for `make run-api` / `make run-worker`.
# Every variable is optional; the values below are the built-in defaults.
# Durations use Go syntax (e.g. 500ms, 15s, 1m) and must be between 100ms and 10m.

# Application environment: development | test | staging | production
APP_ENV=development

# Public API listener (host:port). Use 127.0.0.1:8080 to bind locally only.
HTTP_ADDR=:8080

# Maximum time to read an entire request, including the body.
HTTP_READ_TIMEOUT=15s

# Maximum time to read request headers. Must not exceed HTTP_READ_TIMEOUT.
HTTP_READ_HEADER_TIMEOUT=5s

# Maximum time to write a response.
HTTP_WRITE_TIMEOUT=30s

# How long idle keep-alive connections stay open.
HTTP_IDLE_TIMEOUT=60s

# Deadline for in-flight requests (API) or jobs (worker) to finish after SIGINT/SIGTERM.
SHUTDOWN_TIMEOUT=20s

# Internal Prometheus listener (host:port) serving GET /metrics. Must differ from HTTP_ADDR.
METRICS_ADDR=:9090

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# --- PostgreSQL: User module (FMT-8 / BE-002) ---
# Runtime DSN (user_runtime role, DML only). Read by the api and worker.
# Optional: if unset, the api still starts and /health/live stays healthy,
# but /health/ready reports not-ready. Never logged.
USER_DATABASE_URL=postgres://user_runtime:runtime@localhost:5432/user_db?sslmode=disable
# Migration DSN (user_migrate role, DDL). Read ONLY by cmd/migrate — never by
# the api/worker. Never logged.
USER_MIGRATE_DATABASE_URL=postgres://user_migrate:migrate@localhost:5432/user_db?sslmode=disable
