# Copy to .env to override defaults for `make run-api` / `make run-worker`.
# Every variable is optional; the values below are the built-in defaults.
# Durations use Go syntax (e.g. 500ms, 15s, 1m) and must be between 100ms and 10m.

# Application environment: development | test | staging | production
APP_ENV=development

# Public API listener (host:port). Use 127.0.0.1:8080 to bind locally only.
HTTP_ADDR=:8080

# Maximum time to read an entire request, including the body.
HTTP_READ_TIMEOUT=15s

# Maximum time to read request headers. Must not exceed HTTP_READ_TIMEOUT.
HTTP_READ_HEADER_TIMEOUT=5s

# Maximum time to write a response.
HTTP_WRITE_TIMEOUT=30s

# How long idle keep-alive connections stay open.
HTTP_IDLE_TIMEOUT=60s

# Deadline for in-flight requests (API) or jobs (worker) to finish after SIGINT/SIGTERM.
SHUTDOWN_TIMEOUT=20s

# Internal Prometheus listener (host:port) serving GET /metrics. Must differ from HTTP_ADDR.
METRICS_ADDR=:9090

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# --- User module database (FMT-8) -------------------------------------------
# Both URLs carry a password and are NEVER logged. The migrate URL is read
# ONLY by cmd/migrate; the api and worker read ONLY the runtime URL.

# Runtime connection, used by the api and worker. Connects as the DML-only
# user_runtime role. Optional: when unset the api starts with no database
# readiness check. Must use a postgres:// or postgresql:// scheme.
# USER_DATABASE_URL=postgres://user_runtime:CHANGE_ME@localhost:5432/user_db?sslmode=disable

# Migrate connection, used ONLY by `cmd/migrate` (make migrate). Connects as
# the DDL-capable user_migrate role. Keep it out of the api/worker environment.
# USER_MIGRATE_DATABASE_URL=postgres://user_migrate:CHANGE_ME@localhost:5432/user_db?sslmode=disable

# Role passwords consumed by deployments/postgres/initdb/00-init-user-db.sh
# when bootstrapping the database (never hardcoded in the script).
# USER_MIGRATE_PASSWORD=CHANGE_ME
# USER_RUNTIME_PASSWORD=CHANGE_ME
